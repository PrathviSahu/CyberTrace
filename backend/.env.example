# CyberTrace Environment Configuration Example
# Copy this file to .env and configure your environment variables.

# Server Configuration
PROJECT_NAME="CyberTrace"
DATABASE_URL="sqlite+aiosqlite:///./cybertrace.db"

# BharatCode AI API (Required for live AI investigations, model: qwen-3.8-27b)
# Obtain your API key from https://bharatcode.ai/account
BHARATCODE_API_KEY=""
BHARATCODE_BASE_URL="https://bharatcode.ai/api/model/v1"
BHARATCODE_MODEL="qwen-3.8-27b"
BHARATCODE_TIMEOUT_SECONDS=30.0
BHARATCODE_MAX_TOOL_ROUNDS=5
BHARATCODE_MAX_OUTPUT_TOKENS=2048
BHARATCODE_MAX_TOTAL_TOOL_CALLS=10

# Ingestion Limits
MAX_UPLOAD_SIZE_BYTES=52428800  # 50 MB

